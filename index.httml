  zap:'<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  lock:'<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  shieldok:'<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};
function ic(name, size=16, sw=2){ return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON_PATHS[name]||""}</svg>`; }
function catIcon(id){ return { "jasa-logo":"palette", nokos:"smartphone", jasapost:"megaphone", jasasuntik:"trending", "produk-digital":"package" }[id] || "package"; }

/* ---------- HELPERS ---------- */
const $ = (s, el=document) => el.querySelector(s);
const $$ = (s, el=document) => Array.from(el.querySelectorAll(s));
const esc = (s) => String(s ?? "").replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
const fmt = (n) => n === 0 ? "GRATIS" : "Rp " + Number(n||0).toLocaleString("id-ID");
function maskName(name){ if(!name) return "***"; const c = String(name).trim(); if(c.length<=2) return c+"***"; return c.slice(0,2) + "*".repeat(Math.max(4, Math.min(6, c.length-2))); }
function timeAgo(iso){ const t = new Date(iso).getTime(); if(isNaN(t)) return ""; const s = Math.max(0, Math.floor((Date.now()-t)/1000)); if(s<10) return "baru saja"; if(s<60) return s+" detik lalu"; const m=Math.floor(s/60); if(m<60) return m+" menit lalu"; const h=Math.floor(m/60); if(h<24) return h+" jam lalu"; return Math.floor(h/24)+" hari lalu"; }
function waLink(text){ return "https://wa.me/"+STORE.waNumber+(text ? "?text="+encodeURIComponent(text) : ""); }
function stBadge(st){ return `<span class="st st-${esc(st)}">${esc(STATUS_LABEL[st]||st)}</span>`; }
let toastTimer;
function toast(msg){ const t = $("#toast"); t.textContent = msg; t.classList.add("show"); clearTimeout(toastTimer); toastTimer = setTimeout(()=>t.classList.remove("show"), 2600); }
function lbOpen(src){ $("#lb-img").src = src; $("#lightbox").classList.add("open"); }
function lbClose(){ $("#lightbox").classList.remove("open"); }
function copyText(txt, msg="Tersalin"){ (navigator.clipboard?.writeText(txt) || Promise.reject()).then(()=>toast(msg)).catch(()=>{ const ta=document.createElement("textarea"); ta.value=txt; document.body.appendChild(ta); ta.select(); document.execCommand("copy"); ta.remove(); toast(msg); }); }
async function api(path, opts={}){ const r = await fetch(API_BASE + path, opts); const j = await r.json().catch(()=>({ok:false,error:"Respons tidak valid"})); if(!r.ok && !j.error) j.error = "Gagal terhubung ke server ("+r.status+")"; return j; }
async function compressImage(file, maxDim=1000, quality=0.75){
  const url = URL.createObjectURL(file);
  try{
    const img = await new Promise((res,rej)=>{ const i=new Image(); i.onload=()=>res(i); i.onerror=rej; i.src=url; });
    const scale = Math.min(1, maxDim/Math.max(img.width,img.height));
    const c = document.createElement("canvas");
    c.width = Math.round(img.width*scale); c.height = Math.round(img.height*scale);
    c.getContext("2d").drawImage(img,0,0,c.width,c.height);
    return c.toDataURL("image/jpeg", quality);
  } finally { URL.revokeObjectURL(url); }
}

/* ---------- FORMAT PESANAN / LAPORAN (plaintext utk WA) ---------- */
function buildOrderWa(p){ const lines=["Nama Pembeli: "+p.customerName,"Nomor HP: "+p.customerPhone,"Daftar Pesanan:",p.itemsText,"Metode Pembayaran: "+p.paymentMethod,"Bukti Transfer: [Lampirkan Foto/Screenshot]"]; if(p.orderNumber) lines.unshift("No. Pesanan: "+p.orderNumber); return lines.join("\n"); }
function buildLaporanWa(p){ return ["Nama: "+p.customerName,"Nomor Pesanan / Nota: "+p.orderNumber,"Detail Laporan / Kendala: "+p.description,"Bukti Foto/Video: [Lampirkan Media]"].join("\n"); }

/* ---------- ROUTER (#/view?param=value) ---------- */
const VIEWS = ["beranda","layanan","order","antrian","laporan","tentang","admin","sukses"];
function parseHash(){
  const raw = location.hash.replace(/^#\/?/, "");
  const [path, qs] = raw.split("?");
  const view = VIEWS.includes(path) ? path : "beranda";
  const params = {};
  if(qs) qs.split("&").forEach(p => { const [k,v] = p.split("="); if(k) params[decodeURIComponent(k)] = decodeURIComponent(v||""); });
  return { view, params };
}
function go(hash){
  if(location.hash === hash){ render(); window.scrollTo(0,0); }
  else location.hash = hash;
  mmToggle(false);
}
window.addEventListener("hashchange", () => { render(); window.scrollTo(0,0); });

function findItem(id){ for(const cat of CATALOG){ const item = cat.items.find(i=>i.id===id); if(item) return {category:cat,item}; } return null; }

/* ---------- NAV (pill + tabbar bawah + menu mobile) ---------- */
const NAV = [
  {hash:"#/beranda", label:"Beranda", key:"beranda"},
  {hash:"#/layanan?cat=jasa-logo", label:"Jasa Logo", key:"jasa-logo"},
  {hash:"#/layanan?cat=nokos", label:"Nokos", key:"nokos"},
  {hash:"#/layanan?cat=jasapost", label:"Jasapost", key:"jasapost"},
  {hash:"#/layanan?cat=jasasuntik", label:"Jasasuntik", key:"jasasuntik"},
  {hash:"#/layanan?cat=produk-digital", label:"Produk Digital", key:"produk-digital"},
  {hash:"#/antrian", label:"Antrian", key:"antrian"},
  {hash:"#/laporan", label:"Laporan", key:"laporan"},
  {hash:"#/tentang", label:"Tentang", key:"tentang"},
];
function pillActiveKey(route){
  switch(route.view){
    case "beranda": return "beranda";
    case "layanan": return route.params.cat || null;
    case "order": case "sukses": { const f = route.params.item ? findItem(route.params.item) : null; return f ? f.category.id : null; }
    case "antrian": return "antrian";
    case "laporan": return "laporan";
    case "tentang": return "tentang";
    default: return null;
  }
}
function tabActiveKey(route){
  switch(route.view){
    case "beranda": return "beranda";
    case "layanan": return "layanan";
    case "order": case "sukses": return "order";
    case "antrian": return "antrian";
    case "laporan": return "laporan";
    case "tentang": return "tentang";
    default: return null;
  }
}
function renderNav(route){
  const ak = pillActiveKey(route);
  $("#pillnav").innerHTML = NAV.map(n =>
    `<button type="button" class="${ak===n.key?"on":""}" aria-current="${ak===n.key?"page":"false"}" onclick="go('${n.hash}')">${n.label}</button>`).join("");
  const mk = tabActiveKey(route);
  $("#mm-links").innerHTML =
    NAV.filter(n=>["beranda","antrian","laporan","tentang"].includes(n.key)).map(n =>
      `<button type="button" class="mm-link ${ak===n.key?"on":""}" onclick="go('${n.hash}')">${n.label}</button>`).join("") +
    `<p class="mm-label">Layanan</p>` +
    NAV.filter(n=>["jasa-logo","nokos","jasapost","jasasuntik","produk-digital"].includes(n.key)).map(n =>
      `<button type="button" class="mm-link ${ak===n.key?"on":""}" onclick="go('${n.hash}')">${n.label}</button>`).join("");
  /* ===== KOLOM NAVIGASI DAFTAR MENU DI BAWAH (ala referensi) ===== */
  const TABS = [
    {key:"layanan", hash:"#/layanan", label:"Layanan", icon:"shield"},
    {key:"order", hash:"#/order", label:"Pesan", icon:"cart"},
    {key:"beranda", hash:"#/beranda", label:"Home", icon:"house", home:true},
    {key:"antrian", hash:"#/antrian", label:"Antrian", icon:"clock"},
    {key:"tentang", hash:"#/tentang", label:"Tentang", icon:"info"},
  ];
  $("#tabbar").innerHTML = TABS.map(t =>
    `<button type="button" aria-label="${t.label}" ${(!t.home && mk===t.key) || t.home ? 'aria-current="page"' : ""} class="kipli-tabbar__item${t.home?" kipli-tabbar__item--home":(mk===t.key?" kipli-tabbar__item--current":"")}" onclick="go('${t.hash}')">${ic(t.icon, t.home?20:18, 2.2)}<span>${t.label}</span></button>`).join("");
  $("#laporan-float").classList.toggle("on", mk==="laporan");
}
function mmToggle(open){ $("#mobilemenu").classList.toggle("open", open); $("#mobilemenu").setAttribute("aria-hidden", String(!open)); }
$("#mm-open").addEventListener("click", ()=>mmToggle(true));

/* ---------- TICKER (order terbaru, polling 10s, rotasi 5s) ---------- */
let tickerList = [], tickerIdx = 0, tickerTimer, tickerPoll, tickerClosed = false;
function tickerOff(){ tickerClosed = true; $("#ticker").style.display = "none"; clearInterval(tickerTimer); }
async function pollTicker(){
  if(tickerClosed) return;
  try{
    const j = await api("/api/orders");
    if(j.ok && (j.recent||[]).length){ tickerList = j.recent.slice(0,5); renderTickerItem(); $("#ticker").style.display = "flex"; }
  }catch(e){}
}
function renderTickerItem(){
  const o = tickerList[tickerIdx % Math.max(1,tickerList.length)];
  if(!o) return;
  $("#ticker-item").innerHTML =
    `${ic("cart",15)} <b>${esc(o.maskedName)}</b><span class="t-badge">Beli</span><span>${esc(o.firstItemName)}</span>` +
    `<b style="color:var(--sky)">${fmt(o.total)}</b><span class="muted">${esc(o.categoryName)}</span><time>${timeAgo(o.createdAt)}</time>`;
}
setInterval(()=>{ if(tickerList.length){ tickerIdx++; renderTickerItem(); } }, 5000);

/* ============================================================
   VIEWS
   ============================================================ */
function render(){
  const route = parseHash();
  renderNav(route);
  const el = $("#view");
  const fn = { beranda:vBeranda, layanan:vLayanan, order:vOrder, sukses:vSukses, antrian:vAntrian, laporan:vLaporan, tentang:vTentang, admin:vAdmin }[route.view];
  fn(el, route);
}

