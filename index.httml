<!DOCTYPE html>
<html lang="id" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="KIPLI STORE - Jasa Buat Logo, Nokos, Jasapost & Jasasuntik Saluran. Antrian dapat dilihat siapa pun di browser mana pun.">
<title>KIPLI STORE | Jasa Buat Logo, Nokos, Jasapost & Jasasuntik Saluran</title>
<meta name="theme-color" content="#04081a">
<link rel="icon" id="favicon" href="data:,">
<style>
/* ============================================================
   KIPLI STORE - Single File HTML (CSS inline)
   Tema: BIRU ELECTRIC (dari logo KIPLI STORE)
   ============================================================ */
:root{
  --bg:#04081a; --bg2:#071230; --card:#0a1230; --card2:#0d1740;
  --border:rgba(56,189,248,.16); --border2:rgba(56,189,248,.30);
  --text:#e8f1ff; --muted:#93a8c8;
  --primary:#38bdf8; --blue:#2563eb; --blue2:#60a5fa; --sky:#7dd3fc;
  --green:#25D366; --amber:#fbbf24; --red:#f87171; --emerald:#34d399; --cyan:#22d3ee;
  --grad:linear-gradient(135deg,#38bdf8 0%,#2563eb 58%,#60a5fa 100%);
  --radius:14px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.55;min-height:100vh}
img{max-width:100%}
a{color:var(--sky);text-decoration:none}
button{font-family:inherit;cursor:pointer}
.app{display:flex;flex-direction:column;min-height:100vh}
.wrap{width:100%;max-width:1120px;margin:0 auto;padding:0 16px}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.muted{color:var(--muted)}
.small{font-size:12px}
.hide{display:none!important}
.center{text-align:center}

/* ===== Header / Navbar ===== */
header.top{position:sticky;top:0;z-index:40;background:rgba(4,8,26,.85);backdrop-filter:blur(14px);border-bottom:1px solid var(--border)}
.top-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;height:64px}
.brand{display:flex;align-items:center;gap:10px;background:none;border:0;color:var(--text);flex:0 0 auto}
.brand span{white-space:nowrap;min-width:0}
.brand img{width:44px;height:44px;border-radius:12px;object-fit:cover;box-shadow:0 0 18px rgba(56,189,248,.45);outline:2px solid rgba(56,189,248,.4);outline-offset:-2px}
.brand b{font-size:16px;letter-spacing:.4px;display:flex;align-items:center;gap:4px}
.brand small{display:block;font-size:11px;color:var(--muted);font-weight:400}
.pillnav{display:none;align-items:center;gap:2px;background:rgba(10,18,48,.6);border:1px solid var(--border);border-radius:999px;padding:4px}
@media(min-width:1200px){.pillnav{display:flex}#mm-open{display:none!important}}
@media(min-width:1200px) and (max-width:1340px){.pillnav button{padding:7px 9px;font-size:12.5px}}
.pillnav button{background:none;border:0;border-radius:999px;padding:7px 13px;font-size:13px;font-weight:600;color:var(--muted);white-space:nowrap;transition:.18s}
.pillnav button:hover{background:rgba(56,189,248,.12);color:var(--text)}
.pillnav button.on{background:rgba(56,189,248,.18);color:var(--sky)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:10px 18px;font-size:14px;font-weight:700;min-height:44px;transition:.2s}
.btn-primary{background:var(--grad);color:#fff;box-shadow:0 0 18px rgba(56,189,248,.35)}
.btn-primary:hover{filter:brightness(1.12)}
.btn-ghost{background:rgba(56,189,248,.08);border:1px solid var(--border2);color:var(--sky)}
.btn-ghost:hover{background:rgba(56,189,248,.16)}
.btn-wa{background:var(--green);color:#062d15}
.btn-wa:hover{filter:brightness(1.1)}
.btn-red{background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.35);color:var(--red)}
.btn-sm{min-height:36px;padding:6px 12px;font-size:13px;border-radius:10px}
.iconbtn{background:none;border:0;color:var(--text);width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;border-radius:10px}
.iconbtn:hover{background:rgba(56,189,248,.1)}
#mobilemenu{position:fixed;inset:0;z-index:70;display:none}
#mobilemenu.open{display:block}
#mobilemenu .mm-bg{position:absolute;inset:0;background:rgba(0,0,0,.6)}
#mobilemenu .mm-panel{position:absolute;top:0;right:0;bottom:0;width:280px;background:var(--bg2);border-left:1px solid var(--border);padding:18px;overflow-y:auto}
#mobilemenu .mm-panel button.mm-link{display:flex;width:100%;background:none;border:0;color:var(--text);text-align:left;padding:11px 12px;border-radius:10px;font-size:14px;font-weight:600}
#mobilemenu .mm-panel button.mm-link:hover{background:rgba(56,189,248,.1)}
#mobilemenu .mm-panel button.mm-link.on{background:rgba(56,189,248,.18);color:var(--sky)}
.mm-label{font-size:10px;font-weight:800;letter-spacing:2px;color:var(--sky);margin:14px 0 4px 12px;text-transform:uppercase}

/* ===== Order ticker ===== */
.ticker{position:sticky;top:64px;z-index:39;background:linear-gradient(90deg,rgba(37,99,235,.28),rgba(4,8,26,.85));border-bottom:1px solid var(--border);min-height:44px;display:flex;align-items:center;justify-content:center;gap:10px;padding:6px 12px;font-size:13px}
.ticker .t-item{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center}
.ticker .t-badge{background:var(--grad);color:#fff;border-radius:999px;padding:2px 10px;font-size:11px;font-weight:800}
.ticker .t-x{background:none;border:0;color:var(--muted);font-size:16px}
.ticker time{color:var(--sky);font-weight:700;font-size:12px}

/* ===== Hero ===== */
.hero{position:relative;overflow:hidden;padding:56px 0 48px;
  background:radial-gradient(ellipse 60% 50% at 20% 30%,rgba(37,99,235,.35),transparent 60%),
             radial-gradient(ellipse 50% 60% at 80% 70%,rgba(56,189,248,.22),transparent 60%),
             radial-gradient(ellipse 80% 80% at 50% 50%,rgba(14,42,90,.5),transparent 80%),
             linear-gradient(135deg,#040a1a 0%,#071230 50%,#03081a 100%)}
.hero-grid{display:grid;gap:28px;align-items:center}
@media(min-width:860px){.hero-grid{grid-template-columns:1.4fr 1fr}}
.hero-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 14px;font-size:12px;font-weight:800}
.chip-grad{background:var(--grad);color:#fff}
.chip-out{border:1px solid var(--border2);color:var(--sky);background:rgba(56,189,248,.06)}
.chip-white{background:#fff;color:#0a1230;font-weight:700}
.hero h1{font-size:clamp(30px,6vw,44px);line-height:1.12;background:linear-gradient(90deg,var(--sky),var(--blue2));-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 34px rgba(56,189,248,.35)}
.hero p.lead{color:var(--muted);margin:14px 0 22px;max-width:560px}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap}
.hero-logo{justify-self:center;text-align:center}
.hero-logo img{width:190px;height:190px;border-radius:28px;object-fit:cover;outline:3px solid rgba(56,189,248,.5);outline-offset:-3px;box-shadow:0 0 60px rgba(56,189,248,.45);animation:float 3.2s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-10px) rotate(2deg)}}

/* ===== Quick buttons ===== */
.quick{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:26px 0}
@media(min-width:640px){.quick{grid-template-columns:repeat(3,1fr)}}
.quick button{display:flex;flex-direction:column;align-items:center;gap:10px;background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px 12px;color:var(--text);font-weight:700;font-size:13px;transition:.2s;min-height:44px}
.quick button:hover{border-color:var(--border2);transform:translateY(-3px);box-shadow:0 14px 30px -18px rgba(56,189,248,.5)}
.quick .qi{width:46px;height:46px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:rgba(56,189,248,.14);color:var(--sky)}

/* ===== Sections & cards ===== */
section{padding:38px 0}
.kicker{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border2);background:rgba(56,189,248,.1);border-radius:999px;padding:5px 14px;font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--sky)}
.h2{font-size:clamp(22px,4vw,30px);margin:12px 0 6px}
.sub{color:var(--muted);max-width:640px}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:18px}
.grid{display:grid;gap:16px}
.g2{grid-template-columns:1fr}
.g3{grid-template-columns:1fr}
@media(min-width:700px){.g2{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:repeat(3,1fr)}}
.cat-head{display:flex;align-items:center;gap:12px;margin:26px 0 12px}
.cat-head .ci{width:42px;height:42px;border-radius:12px;background:rgba(56,189,248,.14);color:var(--sky);display:flex;align-items:center;justify-content:center}
.cat-head h3{font-size:17px}
.item{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px;display:flex;flex-direction:column;gap:10px;transition:.2s}
.item:hover{border-color:var(--border2)}
.item .top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}
.item h4{font-size:15px}
.item .desc{font-size:13px;color:var(--muted)}
.item .price{font-weight:800;background:linear-gradient(90deg,var(--sky),var(--blue2));-webkit-background-clip:text;background-clip:text;color:transparent;white-space:nowrap;font-size:16px}
.badge{display:inline-block;border-radius:999px;padding:3px 10px;font-size:10px;font-weight:800;letter-spacing:.5px}
.badge-pop{background:var(--grad);color:#fff}
.badge-free{background:rgba(52,211,153,.15);color:var(--emerald);border:1px solid rgba(52,211,153,.4)}
.badge-hemat{background:rgba(251,191,36,.14);color:var(--amber);border:1px solid rgba(251,191,36,.4)}
.feats{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted)}
.feats span{display:flex;align-items:center;gap:6px}
.feats svg{color:var(--sky)}
.filterbar{display:flex;gap:8px;overflow-x:auto;padding:4px 0 12px;-webkit-overflow-scrolling:touch}
.filterbar button{background:var(--card);border:1px solid var(--border);color:var(--muted);border-radius:999px;padding:9px 16px;font-size:13px;font-weight:700;white-space:nowrap}
.filterbar button.on{background:rgba(56,189,248,.18);border-color:var(--border2);color:var(--sky)}
.notewarn{display:flex;gap:8px;align-items:flex-start;background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.3);border-radius:12px;padding:10px 12px;font-size:12.5px;color:#fcd34d}
.steps{display:grid;gap:14px;grid-template-columns:1fr}
@media(min-width:700px){.steps{grid-template-columns:repeat(4,1fr)}}
.step{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px;position:relative}
.step .num{width:30px;height:30px;border-radius:999px;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;margin-bottom:10px}
.step b{display:block;margin-bottom:4px;font-size:14px}
.step p{font-size:12.5px;color:var(--muted)}
.promo{display:grid;gap:18px;align-items:center;background:linear-gradient(135deg,rgba(37,99,235,.25),rgba(10,18,48,.9));border:1px solid var(--border2);border-radius:18px;padding:24px}
@media(min-width:800px){.promo{grid-template-columns:1fr auto}}

/* ===== Form ===== */
.stepcard{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-bottom:16px}
.stepcard>.schead{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.schead .num{width:28px;height:28px;border-radius:999px;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex:0 0 auto}
.schead b{font-size:15px}
label{display:block;font-size:12.5px;font-weight:700;margin:12px 0 6px}
label .req{color:var(--red)}
input[type=text],input[type=tel],textarea,select{width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:12px 14px;color:var(--text);font-size:14px;font-family:inherit;outline:none;transition:border .2s}
input:focus,textarea:focus,select:focus{border-color:var(--border2)}
textarea{min-height:120px;resize:vertical}
.radiogrid{display:grid;gap:8px}
.radio{display:flex;align-items:center;gap:10px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:.15s;font-size:14px}
.radio:hover{border-color:var(--border2)}
.radio.on{border-color:var(--primary);background:rgba(56,189,248,.1)}
.radio .dot{width:16px;height:16px;border-radius:999px;border:2px solid var(--muted);flex:0 0 auto;position:relative}
.radio.on .dot{border-color:var(--primary)}
.radio.on .dot::after{content:"";position:absolute;inset:2.5px;border-radius:999px;background:var(--primary)}
.radio .rp{margin-left:auto;font-weight:800;white-space:nowrap;font-size:13px}
.upload{border:1.5px dashed var(--border2);border-radius:12px;padding:18px;text-align:center;color:var(--muted);font-size:13px;cursor:pointer;transition:.2s;background:rgba(56,189,248,.03)}
.upload:hover{background:rgba(56,189,248,.08);color:var(--sky)}
.thumb{width:56px;height:56px;object-fit:cover;border-radius:10px;border:1px solid var(--border2);cursor:pointer}
.paybox{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px;font-size:13.5px}
.marquee{overflow:hidden;background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.3);border-radius:10px;padding:8px 0;margin-bottom:14px}
.marquee .m-track{display:inline-flex;white-space:nowrap;animation:marq 18s linear infinite;font-size:12.5px;font-weight:800;color:#fca5a5}
@keyframes marq{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.order-layout{display:grid;gap:20px}
@media(min-width:960px){.order-layout{grid-template-columns:1fr 340px}}
.side{display:flex;flex-direction:column;gap:16px}
@media(min-width:960px){.side{position:sticky;top:84px;align-self:start}}
.total-row{display:flex;justify-content:space-between;align-items:center;font-size:14px;color:var(--muted);padding:6px 0}
.total-all{display:flex;justify-content:space-between;align-items:center;border-top:1px dashed var(--border2);margin-top:8px;padding-top:12px;font-weight:800;font-size:17px}
.total-all .val{background:linear-gradient(90deg,var(--sky),var(--blue2));-webkit-background-clip:text;background-clip:text;color:transparent;font-size:20px}
pre.format{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px;font-size:12.5px;white-space:pre-wrap;word-break:break-word;font-family:ui-monospace,Menlo,Consolas,monospace;color:#bcd3f5;max-height:280px;overflow:auto}

/* ===== Status badges ===== */
.st{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:4px 12px;font-size:11px;font-weight:800;letter-spacing:.3px}
.st-PENDING{background:rgba(251,191,36,.13);color:var(--amber);border:1px solid rgba(251,191,36,.4)}
.st-ANTRIAN{background:rgba(56,189,248,.13);color:var(--sky);border:1px solid rgba(56,189,248,.4)}
.st-DIPROSES{background:rgba(34,211,238,.13);color:var(--cyan);border:1px solid rgba(34,211,238,.4)}
.st-SELESAI{background:rgba(52,211,153,.13);color:var(--emerald);border:1px solid rgba(52,211,153,.4)}
.st-DITOLAK{background:rgba(248,113,113,.13);color:var(--red);border:1px solid rgba(248,113,113,.4)}
.st-OPEN{background:rgba(251,191,36,.13);color:var(--amber);border:1px solid rgba(251,191,36,.4)}
.st-DITINJAU{background:rgba(56,189,248,.13);color:var(--sky);border:1px solid rgba(56,189,248,.4)}

/* ===== Antrian ===== */
.queue-item{display:flex;align-items:center;gap:14px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:14px}
.queue-item .pos{width:46px;height:46px;flex:0 0 auto;border-radius:12px;background:var(--grad);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:16px;color:#fff}
.queue-list{display:flex;flex-direction:column;gap:10px;max-height:420px;overflow-y:auto;padding-right:4px}
.queue-list::-webkit-scrollbar{width:8px}
.queue-list::-webkit-scrollbar-thumb{background:rgba(59,130,246,.45);border-radius:8px}
.queue-list::-webkit-scrollbar-track{background:rgba(30,58,138,.15)}
.empty{border:1.5px dashed var(--border2);border-radius:14px;padding:26px;text-align:center;color:var(--muted);font-size:13.5px}
.skel{height:64px;border-radius:14px;background:linear-gradient(90deg,var(--card) 25%,var(--card2) 50%,var(--card) 75%);background-size:200% 100%;animation:sh 1.4s infinite}
@keyframes sh{0%{background-position:200% 0}100%{background-position:-200% 0}}

/* ===== Sukses ===== */
.sukses{max-width:560px;margin:0 auto;text-align:center;padding:40px 0}
.sukses .big{width:76px;height:76px;margin:0 auto 18px;border-radius:999px;background:rgba(52,211,153,.15);border:1px solid rgba(52,211,153,.45);display:flex;align-items:center;justify-content:center;color:var(--emerald)}
.order-no{display:inline-flex;align-items:center;gap:10px;background:var(--bg2);border:1px solid var(--border2);border-radius:999px;padding:10px 20px;font-weight:800;letter-spacing:1px}

/* ===== Toast & lightbox ===== */
#toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%) translateY(20px);background:var(--card2);border:1px solid var(--border2);color:var(--text);border-radius:12px;padding:11px 18px;font-size:13.5px;font-weight:600;z-index:100;opacity:0;pointer-events:none;transition:.25s;box-shadow:0 18px 40px -18px rgba(0,0,0,.8)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#lightbox{position:fixed;inset:0;z-index:90;background:rgba(0,0,0,.85);display:none;align-items:center;justify-content:center;padding:20px}
#lightbox.open{display:flex}
#lightbox img{max-width:100%;max-height:88vh;border-radius:12px}
#lightbox .lb-x{position:absolute;top:14px;right:14px}

/* ===== Admin ===== */
.login-box{max-width:400px;margin:40px auto}
.admin-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:14px}
.admin-card .ahead{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
.admin-card .items{display:flex;flex-direction:column;gap:6px;font-size:13.5px;background:var(--bg2);border-radius:10px;padding:10px 12px;margin:8px 0}
.opt-line{font-size:12.5px;color:var(--muted)}
.note-in{display:flex;gap:8px;margin-top:10px}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.tabs{display:flex;gap:6px;background:var(--card);border:1px solid var(--border);border-radius:999px;padding:4px;width:fit-content;margin-bottom:18px}
.tabs button{background:none;border:0;border-radius:999px;padding:8px 20px;font-weight:700;font-size:13.5px;color:var(--muted)}
.tabs button.on{background:var(--grad);color:#fff}

/* ===== Footer ===== */
footer{margin-top:auto;background:rgba(7,18,48,.6);border-top:1px solid var(--border);padding-bottom:144px}
@media(min-width:768px){footer{padding-bottom:0}}
.foot-grid{display:grid;gap:28px;padding:38px 0}
@media(min-width:640px){.foot-grid{grid-template-columns:1fr 1fr}}
@media(min-width:1000px){.foot-grid{grid-template-columns:1.4fr 1fr 1fr 1.2fr}}
footer h5{font-size:11px;font-weight:800;letter-spacing:2px;color:var(--sky);text-transform:uppercase;margin-bottom:12px}
footer .flink{display:block;background:none;border:0;color:var(--muted);font-size:14px;padding:5px 0;text-align:left}
footer .flink:hover{color:var(--sky)}
.foot-bar{border-top:1px solid var(--border);padding:16px 0;font-size:12px;color:var(--muted)}
.foot-bar .wrap{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}

/* ============================================================
   BOTTOM TABBAR — kolom navigasi daftar menu di bawah
   (sama seperti website referensi, warna biru electric)
   ============================================================ */
.kipli-tabbar{position:fixed;right:0;bottom:0;left:0;z-index:60;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));padding:12px 7px calc(7px + env(safe-area-inset-bottom));background:rgba(4,10,26,.92);border-top:1px solid rgba(56,189,248,.18);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:inset 0 1px rgba(255,255,255,.08),0 -10px 30px -24px rgba(0,0,0,.9)}
.kipli-tabbar__item{position:relative;z-index:1;display:grid;place-items:center;align-content:center;gap:4.5px;min-width:0;min-height:52px;border:0;background:none;border-radius:17px;color:var(--muted);font-size:10.9px;font-weight:900;line-height:1;transition:color .42s cubic-bezier(.22,1,.36,1),background-color .42s cubic-bezier(.22,1,.36,1)}
.kipli-tabbar__item svg{width:18px;height:18px;color:var(--primary);transition:color .42s cubic-bezier(.22,1,.36,1)}
.kipli-tabbar__item span{display:block;width:100%;max-width:67px;overflow:hidden;white-space:nowrap;text-align:center;text-overflow:ellipsis}
.kipli-tabbar__item--current{color:var(--sky)}
.kipli-tabbar__item--current svg{color:var(--sky)}
.kipli-tabbar__item--home{z-index:4;min-height:64px;border-radius:18px;background:var(--grad);color:#fff;box-shadow:0 0 0 5.1px rgba(4,10,26,.92),inset 0 1px rgba(255,255,255,.42),0 16px 34px -22px rgba(56,189,248,.95);transform:translateY(-20px) scale(1.04);animation:kipli-nav-lift .52s cubic-bezier(.22,1,.36,1)}
.kipli-tabbar__item--home svg{width:20px;height:20px;color:currentColor}
@keyframes kipli-nav-lift{from{transform:translateY(0) scale(.92)}to{transform:translateY(-20px) scale(1.04)}}
.btn-laporan-float{position:fixed;right:16px;bottom:96px;z-index:61;display:inline-flex;align-items:center;gap:8px;border-radius:999px;border:1px solid rgba(248,113,113,.3);background:var(--card);color:var(--red);padding:12px 16px;font-size:14px;font-weight:900;box-shadow:0 10px 26px -12px rgba(0,0,0,.7);transition:.2s;min-height:44px}
.btn-laporan-float:hover{background:rgba(248,113,113,.1)}
.btn-laporan-float.on{border-color:rgba(248,113,113,.6);background:rgba(248,113,113,.2);color:#fca5a5}
@media(min-width:768px){.kipli-tabbar,.btn-laporan-float{display:none}}
</style>
</head>
<body>
<div class="app">

  <!-- ============ HEADER / NAVBAR ============ -->
  <header class="top">
    <div class="wrap top-inner">
      <button class="brand" onclick="go('#/beranda')" aria-label="KIPLI STORE - kembali ke beranda">
        <img data-kipli-logo alt="Logo KIPLI STORE">
        <span><b>KIPLI STORE
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>
        </b><small>Pusat Layanan KIPLI STORE</small></span>
      </button>
      <nav class="pillnav" id="pillnav" aria-label="Navigasi utama"></nav>
      <div style="display:flex;gap:8px;align-items:center">
        <button class="btn btn-primary btn-sm" style="border-radius:999px" onclick="go('#/antrian')" aria-label="Cek status pesanan">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          Cek Status
        </button>
        <button class="iconbtn" id="mm-open" aria-label="Buka menu navigasi">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile menu overlay -->
  <div id="mobilemenu" aria-hidden="true">
    <div class="mm-bg" onclick="mmToggle(false)"></div>
    <div class="mm-panel" role="dialog" aria-label="Menu navigasi">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
        <b style="background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent">MENU KIPLI STORE</b>
        <button class="iconbtn" onclick="mmToggle(false)" aria-label="Tutup menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
      </div>
      <div id="mm-links"></div>
    </div>
  </div>

  <!-- ============ ORDER TICKER ============ -->
  <div class="ticker" id="ticker" style="display:none">
    <div class="t-item" id="ticker-item"></div>
    <button class="t-x" onclick="tickerOff()" aria-label="Tutup notifikasi order">✕</button>
  </div>

  <!-- ============ MAIN (semua halaman dirender di sini) ============ -->
  <main style="flex:1" id="view"></main>

  <!-- ============ FOOTER ============ -->
  <footer>
    <div class="wrap foot-grid">
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
          <img data-kipli-logo alt="Logo KIPLI STORE" style="width:44px;height:44px;border-radius:12px;object-fit:cover;outline:2px solid rgba(56,189,248,.4);outline-offset:-2px">
          <div><b style="display:flex;align-items:center;gap:4px">KIPLI STORE
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg></b>
          <small class="muted" style="font-size:11px">Jasa Buat Logo, Nokos, Jasapost & Jasasuntik Saluran</small></div>
        </div>
        <p class="muted small" style="max-width:300px">Pusat layanan untuk order Jasa Buat Logo, Nokos, Jasapost, Jasasuntik Saluran, produk digital, dan pemantauan antrian.</p>
        <button class="btn btn-ghost btn-sm" style="margin-top:12px" onclick="go('#/layanan')">Lihat Paket</button>
      </div>
      <nav aria-label="Bantuan footer">
        <h5>Bantuan</h5>
        <button class="flink" onclick="go('#/antrian')">Cek Status Order</button>
        <button class="flink" onclick="go('#/layanan')">Buat Pesanan</button>
        <button class="flink" onclick="go('#/antrian')">Antrian Pesanan</button>
        <button class="flink" onclick="go('#/laporan')">Laporan Kendala</button>
      </nav>
      <nav aria-label="Layanan footer">
        <h5>Layanan</h5>
        <button class="flink" onclick="go('#/layanan?cat=jasa-logo')">Jasa Buat Logo</button>
        <button class="flink" onclick="go('#/layanan?cat=nokos')">Nokos</button>
        <button class="flink" onclick="go('#/layanan?cat=jasapost')">Jasapost</button>
        <button class="flink" onclick="go('#/layanan?cat=jasasuntik')">Jasasuntik Saluran</button>
        <button class="flink" onclick="go('#/layanan?cat=produk-digital')">Produk Digital</button>
        <button class="flink" onclick="go('#/tentang')">Pembayaran QRIS</button>
      </nav>
      <div>
        <h5>Kontak</h5>
        <a class="btn btn-wa btn-sm" style="border-radius:12px" href="https://wa.me/6285861746705" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          WA CS +62 858-6174-6705
        </a>
        <p class="muted small" style="margin-top:10px;display:flex;gap:6px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" style="flex:0 0 auto;margin-top:2px"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg> Gg Sukarata RT19 RW 06 Purwakarta Cipaisan Jawa Barat</p>
        <p class="muted small" style="margin-top:6px;display:flex;gap:6px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" style="flex:0 0 auto;margin-top:2px"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Buka Setiap Hari: 05.00 - 21.00 WIB</p>
      </div>
    </div>
    <div class="foot-bar">
      <div class="wrap">
        <span>Copyright © <span id="year"></span> KIPLI STORE. All rights reserved.</span>
        <span>Semua transaksi diproses manual oleh admin.</span>
      </div>
    </div>
  </footer>

  <!-- ============ TOMBOL FLOATING LAPORAN ============ -->
  <button class="btn-laporan-float" id="laporan-float" onclick="go('#/laporan')" aria-label="Buat laporan kendala">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
    Laporan
  </button>

  <!-- ============ KIPLI-TABBAR : KOLOM NAVIGASI DAFTAR MENU DI BAWAH ============ -->
  <nav class="kipli-tabbar" id="tabbar" aria-label="Navigasi utama mobile"></nav>

  <div id="toast" role="status"></div>
  <div id="lightbox" onclick="lbClose()"><button class="iconbtn lb-x" aria-label="Tutup gambar"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button><img id="lb-img" alt="Pratinjau gambar"></div>
</div>

<script>
/* ============================================================
   KIPLI STORE - Single File HTML (JS inline, tanpa framework)
   ============================================================ */

/* ============================================================
   KONFIGURASI PENTING (WAJIB DIBACA)
