/* ---------- LAYANAN (katalog) ---------- */
function vLayanan(el, route){
  const cat = route.params.cat || "all";
  const cats = cat==="all" ? CATALOG : CATALOG.filter(c=>c.id===cat);
  el.innerHTML = `
  <section class="wrap">
    <span class="kicker">Daftar Layanan</span>
    <h2 class="h2">Pilih layanan, klik <span style="color:var(--sky)">Pesan Paket</span>.</h2>
    <p class="sub">Harga tanpa pajak & tanpa kode unik. Semua pesanan diproses manual oleh admin.</p>
    <div class="filterbar" style="margin-top:16px">
      <button class="${cat==="all"?"on":""}" onclick="go('#/layanan')">Semua</button>
      ${CATALOG.map(c=>`<button class="${cat===c.id?"on":""}" onclick="go('#/layanan?cat=${c.id}')">${esc(c.shortName)}</button>`).join("")}
    </div>
    ${cats.map(c => `
      <div id="cat-${c.id}" style="scroll-margin-top:96px">
        <div class="cat-head">
          <span class="ci">${ic(catIcon(c.id),20)}</span>
          <div><h3>${esc(c.name)}</h3><p class="small muted">${esc(c.desc)}</p></div>
        </div>
        ${c.notes ? `<div style="display:flex;flex-direction:column;gap:6px;margin-bottom:12px">${c.notes.map(n=>`<div class="notewarn">${ic("warn",14)} ${esc(n)}</div>`).join("")}</div>` : ""}
        <div class="grid ${c.id==="jasasuntik"?"g2":"g3"}">
          ${c.items.map(it => `
          <div class="item">
            <div class="top">
              <h4>${esc(it.name)}</h4>
              ${it.badge?`<span class="badge ${it.badgeCls||"badge-pop"}">${esc(it.badge)}</span>`:""}
            </div>
            <p class="desc">${esc(it.desc)}</p>
            ${it.features?`<div class="feats">${it.features.map(f=>`<span>${ic("check",13)} ${esc(f)}</span>`).join("")}</div>`:""}
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:8px">
              <b class="price">${fmt(it.price)}</b>
              <button class="btn btn-primary btn-sm" onclick="go('#/order?item=${it.id}')">Pesan Paket</button>
            </div>
          </div>`).join("")}
        </div>
      </div>`).join("")}
  </section>`;
  if(cat!=="all"){ const t = $("#cat-"+cat, el); if(t) setTimeout(()=>t.scrollIntoView({behavior:"smooth",block:"start"}), 60); }
}

/* ---------- ORDER (mesin order 3 langkah) ---------- */
const orderState = { fields:{}, bukti:null, fixedItem:null };
function vOrder(el, route){
  const fixed = route.params.item ? findItem(route.params.item) : null;
  orderState.fields = {}; orderState.bukti = null; orderState.fixedItem = fixed ? fixed.item.id : null;
  const marquee = (text) => `<div class="marquee" id="omarq"><div class="m-track"><span style="padding-right:40px">${esc(text)}</span><span style="padding-right:40px">${esc(text)}</span></div></div>`;
  const itemSelector = fixed ? `
    <div class="paybox" style="border-color:var(--border2)">
      <b>${esc(fixed.item.name)}</b> <span class="muted small">— ${esc(fixed.category.name)}</span>
      <b class="price" style="float:right">${fmt(fixed.item.price)}</b>
    </div>` : `
    <div class="radiogrid" id="itempick">
      ${CATALOG.map(c => c.items.map((it,i) => `
        <label class="radio" data-item="${it.id}">
          <span class="dot"></span>
          <span>${esc(it.name)} <span class="muted small">• ${esc(c.shortName)}</span></span>
          <span class="rp">${fmt(it.price)}</span>
        </label>`).join("")).join("")}
    </div>`;
  el.innerHTML = `
  <section class="wrap" style="padding-top:30px">
    <span class="kicker">Buat Pesanan</span>
    <h2 class="h2">Order selesai dalam 3 langkah.</h2>
    <p class="sub">Tanpa pajak & tanpa kode unik — bayar persis sesuai total.</p>
    <div class="order-layout" style="margin-top:22px">
      <div>
        <div class="stepcard">
          <div class="schead"><span class="num">1</span><b>Data Customer</b></div>
          <label for="o-nama">NAMA <span class="req">*</span></label>
          <input type="text" id="o-nama" placeholder="Nama kamu" autocomplete="name">
          <label for="o-wa">NOMOR WHATSAPP <span class="req">*</span></label>
          <input type="tel" id="o-wa" placeholder="08xxxxxxxxxx" autocomplete="tel">
        </div>
        <div class="stepcard">
          <div class="schead"><span class="num">2</span><b>Pilih Item & Opsi</b></div>
          ${fixed ? marquee(marqueeText(fixed)) : marquee("( KIPLI STORE ) PESAN SEKARANG — TANPA PAJAK / KODE UNIK — ANTRIAN TRANSPARAN")}
          ${itemSelector}
          <div id="extrafields"></div>
        </div>
        <div class="stepcard">
          <div class="schead"><span class="num">3</span><b>Pembayaran</b></div>
          <div class="radiogrid" id="paypick">
            ${PAYMENTS.map((p,i)=>`
            <label class="radio${i===0?" on":""}" data-pay="${p.id}">
              <span class="dot"></span>
              <span>${esc(p.label)}<br><span class="muted small">${esc(p.desc)}</span></span>
            </label>`).join("")}
          </div>
          <div id="paydetail" style="margin-top:12px"></div>
          <label>BUKTI TRANSFER (FOTO)</label>
          <div class="upload" id="bukti-drop" role="button" tabindex="0" aria-label="Upload bukti transfer">${ic("upload",18)}<br>Klik untuk upload foto bukti transfer<br><span class="small muted">JPG/PNG — dikompres otomatis</span></div>
          <input type="file" id="bukti-file" accept="image/*" class="hide">
          <div id="bukti-prev" style="margin-top:10px"></div>
          <label>CATATAN (OPSIONAL)</label>
          <textarea id="o-note" style="min-height:80px" placeholder="Catatan tambahan untuk admin..."></textarea>
          <button class="btn btn-primary" id="o-submit" style="width:100%;margin-top:14px;font-size:15px">${ic("check",17)} KIRIM PESANAN</button>
          <p class="small muted center" style="margin-top:10px">Pesanan masuk ke antrian admin. Antrian dapat dilihat siapa pun di browser mana pun.</p>
        </div>
      </div>
      <div class="side">
        <div class="card">
          <b style="font-size:15px">Ringkasan Order</b>
          <div id="o-summary" style="margin-top:8px"></div>
        </div>
        <div class="card">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;color:var(--amber)">${ic("star",15)}<b style="color:var(--text)">4.9/5.0</b><span class="muted small">— ulasan pembeli</span></div>
          <div style="color:var(--amber)">${ic("star",14)}${ic("star",14)}${ic("star",14)}${ic("star",14)}${ic("star",14)}</div>
        </div>
        <div class="card">
          <b style="font-size:13.5px">${ic("shieldok",15)} Transaksi Aman</b>
          <p class="small muted" style="margin-top:6px">Konfirmasi manual oleh admin CS. Ada pertanyaan?</p>
          <a class="btn btn-wa btn-sm" style="width:100%;margin-top:10px" href="${waLink("Halo CS KIPLI STORE, saya mau tanya.")}" target="_blank" rel="noopener">${ic("wa",14)} WA CS ${STORE.waDisplay}</a>
        </div>
        <div class="card">
          <b style="font-size:13.5px">FORMAT PESANAN (WhatsApp)</b>
          <pre class="format" id="format-order"></pre>
          <button class="btn btn-ghost btn-sm" style="width:100%;margin-top:10px" onclick="copyText(document.getElementById('format-order').textContent,'Format pesanan tersalin')">${ic("copy",14)} Salin Format</button>
        </div>
      </div>
    </div>
  </section>`;

  const selectedItem = () => fixed ? fixed : (orderState.sel ? findItem(orderState.sel) : null);
  function refresh(){
    // radio visual
    $$("#itempick .radio", el).forEach(r => r.classList.toggle("on", r.dataset.item === orderState.sel));
    // ringkasan
    const f = selectedItem();
    $("#o-summary", el).innerHTML = f ? `
      <div class="total-row"><span>${esc(f.item.name)}</span><b style="color:var(--text)">${fmt(f.item.price)}</b></div>
      <div class="total-all"><span>Total</span><span class="val">${fmt(f.item.price)}</span></div>` :
      `<p class="small muted">Belum ada item dipilih.</p>`;
    // format pesanan
    const nama = $("#o-nama", el).value.trim() || "(nama kamu)";
    const wa = $("#o-wa", el).value.trim() || "(nomor wa)";
    $("#format-order", el).textContent = buildOrderWa({
      customerName: nama, customerPhone: wa,
      itemsText: f ? `- ${f.item.name} (${fmt(f.item.price)})` : "- (pilih item)",
      paymentMethod: orderState.pay || "QRIS",
    });
  }
  function renderExtra(){
    const f = selectedItem();
    /* marquee mengikuti kategori item yang dipilih (sama seperti aplikasi utama) */
    const mq = $("#omarq", el);
    if(mq){ const mt = f ? marqueeText(f) : "( KIPLI STORE ) PESAN SEKARANG — TANPA PAJAK / KODE UNIK — ANTRIAN TRANSPARAN"; $$("span", mq).forEach(s => s.textContent = mt); }
    const box = $("#extrafields", el);
    if(!f || !f.category.extraFields){ box.innerHTML = ""; return; }
    box.innerHTML = f.category.extraFields.map(fd => {
      const val = orderState.fields[fd.key] ?? fd.prefill ?? "";
      if(fd.type === "image"){
        return `<label>${esc(fd.label)} ${fd.required?'<span class="req">*</span>':""}</label>
          <div class="upload" data-up="${fd.key}" role="button" tabindex="0">${ic("upload",17)}<br>Lampirkan foto (klik di sini)</div>
          <input type="file" class="hide" data-upfile="${fd.key}" accept="image/*">
          <div data-upprev="${fd.key}" style="margin-top:8px">${val?`<img src="${val}" class="thumb" alt="Foto ${esc(fd.label)}" onclick="lbOpen(this.src)"> <button class="btn btn-red btn-sm" onclick="orderState.fields['${fd.key}']=null;renderExtra()">Hapus</button>`:""}</div>`;
      }
      if(fd.type === "textarea"){
        return `<label>${esc(fd.label)} ${fd.required?'<span class="req">*</span>':""}</label>
          <textarea data-f="${fd.key}" placeholder="${esc(fd.placeholder||"")}">${esc(val)}</textarea>`;
      }
      return `<label>${esc(fd.label)} ${fd.required?'<span class="req">*</span>':""}</label>
        <input type="text" data-f="${fd.key}" value="${esc(val)}" placeholder="${esc(fd.placeholder||"")}">`;
    }).join("");
    $$("[data-f]", box).forEach(inp => inp.addEventListener("input", () => { orderState.fields[inp.dataset.f] = inp.value; }));
    $$("[data-up]", box).forEach(u => u.addEventListener("click", () => $(`[data-upfile="${u.dataset.up}"]`, box).click()));
    $$("[data-upfile]", box).forEach(inp => inp.addEventListener("change", async () => {
      const file = inp.files[0]; if(!file) return;
      try{ orderState.fields[inp.dataset.upfile] = await compressImage(file); toast("Foto ditambahkan"); renderExtra(); }
      catch(e){ toast("Gagal memproses foto"); }
    }));
  }
  window.renderExtra = renderExtra; /* diekspos agar tombol Hapus foto (inline onclick) berfungsi */
  function renderPay(){
    const pay = orderState.pay || "QRIS";
    $$("#paypick .radio", el).forEach(r => r.classList.toggle("on", r.dataset.pay === pay));
    const box = $("#paydetail", el);
    if(pay === "QRIS"){
      box.innerHTML = `<div class="paybox" style="text-align:center">
        <img src="${STORE.qrisUrl}" alt="QRIS KIPLI STORE" style="max-width:220px;width:100%;border-radius:12px;margin:0 auto 10px;display:block" onclick="lbOpen(this.src)">
        <b>Scan QRIS di atas</b><p class="small muted">Semua e-wallet & mobile banking • tanpa biaya admin</p></div>`;
    } else {
      const p = PAYMENTS.find(x=>x.id===pay);
      box.innerHTML = `<div class="paybox"><b>${esc(p.label)}</b><p style="margin-top:4px">${esc(p.desc)}</p>
        <div style="display:flex;align-items:center;gap:8px;margin-top:10px">
          <b class="mono" style="font-size:17px;letter-spacing:1px">089504379090</b>
          <button class="btn btn-ghost btn-sm" onclick="copyText('089504379090')">${ic("copy",13)} Salin</button>
        </div></div>`;
    }
  }
  function marqueeText(f){
    if(f.category.id === "jasapost") return "JASAPOST — BUKAN PUNYA ADMIN • WAJIB MC ADMIN DARI GB ADMIN • BE SMART BUYER • BOLEH APA SAJA UNTUK DI JP";
    if(f.category.id === "jasa-logo") return "JASA BUAT LOGO — LAMPIRKAN FOTO LOGO • SEBUTKAN NAMA, WARNA & ELEMEN • PROSES CEPAT";
    return "PESANAN DIPROSES MANUAL OLEH ADMIN • TANPA PAJAK / KODE UNIK • SIMPAN NOMOR ORDER KAMU";
  }
  // bindings
  el.onclick = (e) => {
    const r = e.target.closest("#itempick .radio");
    if(r){ orderState.sel = r.dataset.item; renderExtra(); refresh(); }
    const p = e.target.closest("#paypick .radio");
    if(p){ orderState.pay = p.dataset.pay; renderPay(); refresh(); }
  };
  $("#o-nama", el).addEventListener("input", refresh);
  $("#o-wa", el).addEventListener("input", refresh);
  $("#bukti-drop", el).addEventListener("click", ()=>$("#bukti-file", el).click());
  $("#bukti-file", el).addEventListener("change", async () => {
    const file = $("#bukti-file", el).files[0]; if(!file) return;
    try{ orderState.bukti = await compressImage(file); toast("Bukti transfer siap"); $("#bukti-prev", el).innerHTML = `<img src="${orderState.bukti}" class="thumb" alt="Bukti transfer" onclick="lbOpen(this.src)"> <button class="btn btn-red btn-sm" onclick="orderState.bukti=null;document.getElementById('bukti-prev').innerHTML=''">Hapus</button>`; }
    catch(e){ toast("Gagal memproses foto"); }
  });
  $("#o-submit", el).addEventListener("click", submitOrder);
  orderState.pay = "QRIS";
  renderExtra(); renderPay(); refresh();
}
async function submitOrder(){
  const route = parseHash();
  const fixed = route.params.item ? findItem(route.params.item) : null;
  const nama = $("#o-nama").value.trim(), wa = $("#o-wa").value.trim();
  if(nama.length < 2) return toast("Isi nama kamu dulu");
  if(wa.replace(/\D/g,"").length < 9) return toast("Nomor WhatsApp tidak valid");
  const selId = fixed ? fixed.item.id : orderState.sel;
  if(!selId) return toast("Pilih item dulu");
  const f = findItem(selId);
  // validasi extraFields wajib
  for(const fd of (f.category.extraFields||[])){
    const v = orderState.fields[fd.key];
    if(fd.required && (!v || String(v).trim()==="")) return toast("Lengkapi: " + fd.label);
  }
  const btn = $("#o-submit"); btn.disabled = true; btn.textContent = "Mengirim...";
  try{
    const options = {};
    for(const fd of (f.category.extraFields||[])){
      const v = orderState.fields[fd.key];
      if(v != null && String(v).trim() !== "") options[fd.key] = v;
    }
    const j = await api("/api/orders", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        customerName: nama, customerPhone: wa,
        items: [{ id: f.item.id, name: f.item.name, price: f.item.price, qty: 1, options }],
        note: $("#o-note").value.trim() || undefined,
        paymentMethod: orderState.pay || "QRIS",
        buktiUrl: orderState.bukti || undefined,
      }),
    });
    if(j.ok && j.order){ go("#/sukses?no=" + encodeURIComponent(j.order.orderNumber)); }
    else { toast(j.error || "Gagal membuat pesanan"); btn.disabled = false; btn.innerHTML = ic("check",17)+" KIRIM PESANAN"; }
  }catch(e){ toast("Tidak dapat terhubung ke server"); btn.disabled = false; btn.innerHTML = ic("check",17)+" KIRIM PESANAN"; }
}

/* ---------- SUKSES ---------- */
function vSukses(el, route){
