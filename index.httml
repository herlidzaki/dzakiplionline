  el.innerHTML = `
  <section class="wrap"><div class="sukses">
    <div class="big">${ic("check",36,2.4)}</div>
    <h2 class="h2">Pesanan Terkirim!</h2>
    <p class="muted" style="margin:8px 0 18px">Simpan nomor order kamu untuk cek status antrian.</p>
    <div class="order-no"><span class="mono" style="font-size:18px">${esc(no)}</span>
      <button class="iconbtn" style="width:32px;height:32px" onclick="copyText('${esc(no)}')" aria-label="Salin nomor order">${ic("copy",15)}</button>
    </div>
    <div style="margin:16px 0">${stBadge("PENDING")}</div>
    <p class="small muted">Status: MENUNGGU KONFIRMASI → MASUK ANTRIAN → DIPROSES → SELESAI</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:24px">
      <a class="btn btn-wa" href="${waLink("Halo CS KIPLI STORE, saya sudah order dengan nomor " + no + ". Berikut bukti transfernya.")}" target="_blank" rel="noopener">${ic("wa",16)} Kirim Konfirmasi via WhatsApp</a>
      <button class="btn btn-ghost" onclick="go('#/antrian?no=${esc(no)}')">${ic("search",16)} Cek Status</button>
      <button class="btn btn-ghost" onclick="go('#/beranda')">Beranda</button>
    </div>
  </div></section>`;
}

/* ---------- ANTRIAN (publik, polling 10s) ---------- */
let antrianTimer;
function vAntrian(el, route){
  const no = route.params.no || "";
  el.innerHTML = `
  <section class="wrap" style="padding-top:30px">
    <span class="kicker">Antrian Pesanan</span>
    <h2 class="h2">Pantau antrian dan status pesanan.</h2>
    <p class="sub">Lihat antrian aktif atau masukkan nomor order untuk memantau status pesanan. Antrian dapat dilihat oleh siapapun dan di browser mana pun.</p>
    <div class="grid g2" style="margin-top:20px;align-items:start">
      <div class="card">
        <b style="color:var(--sky);font-size:12px;letter-spacing:2px">CEK STATUS</b>
        <h3 style="margin:6px 0 12px;font-size:19px">Cari berdasarkan nomor order.</h3>
        <input type="text" id="q-no" class="mono" placeholder="KP-2026-0001" value="${esc(no)}">
        <button class="btn btn-primary" id="q-btn" style="width:100%;margin-top:12px">${ic("search",16)} Cek Status</button>
        <div id="q-result" style="margin-top:14px"></div>
      </div>
      <div class="card">
        <b style="color:var(--sky);font-size:12px;letter-spacing:2px">ANTREAN AKTIF</b>
        <h3 style="margin:6px 0 12px;font-size:19px">Antrean pesanan hari ini.</h3>
        <div class="queue-list" id="queue-list"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
      </div>
    </div>
  </section>`;
  $("#q-btn", el).addEventListener("click", checkStatus);
  $("#q-no", el).addEventListener("keydown", e => { if(e.key === "Enter") checkStatus(); });
  if(no) checkStatus();
  clearInterval(antrianTimer);
  loadQueue();
  antrianTimer = setInterval(loadQueue, 10000);
}
async function loadQueue(){
  const box = $("#queue-list"); if(!box) { clearInterval(antrianTimer); return; }
  try{
    const j = await api("/api/orders");
    if(!j.ok) throw 0;
    if(!j.queue.length){ box.innerHTML = `<div class="empty">Belum ada antrian aktif.<br>Jadilah yang pertama order hari ini! <button class="btn btn-primary btn-sm" style="margin-top:10px" onclick="go('#/layanan')">Order Sekarang</button></div>`; return; }
    box.innerHTML = j.queue.map((q,i) => `
      <div class="queue-item">
        <span class="pos">#${i+1}</span>
        <div style="min-width:0;flex:1">
          <b class="mono">${esc(q.orderNumber)}</b>
          <p class="small muted">${esc(q.maskedName)} • ${esc(q.itemsSummary)} ${q.categoryName?`• ${esc(q.categoryName)}`:""}</p>
        </div>
        ${stBadge(q.status)}
      </div>`).join("");
  }catch(e){ box.innerHTML = `<div class="empty">Tidak dapat memuat antrian.<br><span class="small">Periksa koneksi / buka lewat server KIPLI STORE.</span></div>`; }
}
async function checkStatus(){
  const no = $("#q-no").value.trim(); if(!no) return toast("Masukkan nomor order dulu");
  const box = $("#q-result");
  box.innerHTML = `<div class="skel" style="height:90px"></div>`;
  try{
    const j = await api("/api/orders?orderNumber=" + encodeURIComponent(no));
    if(!j.ok){ box.innerHTML = `<div class="empty">${esc(j.error||"Pesanan tidak ditemukan")}</div>`; return; }
    const o = j.order;
    box.innerHTML = `
      <div class="card" style="background:var(--bg2)">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
          <b class="mono" style="font-size:16px">${esc(o.orderNumber)}</b>${stBadge(o.status)}
        </div>
        <div style="margin:10px 0;display:flex;flex-direction:column;gap:4px;font-size:13.5px">
          ${o.items.map(it=>`<span>${esc(it.qty)}× ${esc(it.name)} — <b>${fmt(it.price*it.qty)}</b></span>`).join("")}
        </div>
        <div class="total-row"><span>Total</span><b style="color:var(--sky)">${fmt(o.total)}</b></div>
        <div class="total-row"><span>Metode</span><span>${esc(PAYMENT_LABELS[o.paymentMethod]||o.paymentMethod)}</span></div>
        ${o.queuePosition != null ? `<div class="total-row"><span>Nomor Antrian</span><b style="color:var(--emerald);font-size:16px">#${o.queuePosition}</b></div>` : ""}
        ${o.adminNote ? `<div class="notewarn" style="margin-top:8px">${ic("info",14)} Catatan admin: ${esc(o.adminNote)}</div>` : ""}
        <p class="small muted" style="margin-top:8px">Dibuat ${timeAgo(o.createdAt)}</p>
      </div>`;
  }catch(e){ box.innerHTML = `<div class="empty">Tidak dapat terhubung ke server.</div>`; }
}

/* ---------- LAPORAN ---------- */
function vLaporan(el){
  el.innerHTML = `
  <section class="wrap" style="padding-top:30px">
    <span class="kicker">Laporan Kendala</span>
    <h2 class="h2">Ada masalah dengan pesanan? Lapor di sini.</h2>
    <p class="sub">Tim CS membalas maksimal 1×24 jam. Lampirkan foto bukti bila ada.</p>
    <div class="grid g2" style="margin-top:20px;align-items:start">
      <div class="card">
        <div id="lp-form">
          <label>NAMA <span class="req">*</span></label>
          <input type="text" id="lp-nama" placeholder="Nama kamu">
          <label>NOMOR PESANAN / NOTA</label>
          <input type="text" id="lp-no" class="mono" placeholder="KP-2026-0001 (opsional)">
          <label>DETAIL LAPORAN / KENDALA <span class="req">*</span></label>
          <textarea id="lp-desc" placeholder="Ceritakan kendala yang kamu alami..."></textarea>
          <label>FOTO BUKTI (MAKS 3)</label>
          <div class="upload" id="lp-drop" role="button" tabindex="0">${ic("upload",18)}<br>Klik untuk upload foto (maks 3)</div>
          <input type="file" id="lp-file" accept="image/*" multiple class="hide">
          <div id="lp-prev" style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap"></div>
          <button class="btn btn-primary" id="lp-submit" style="width:100%;margin-top:14px">${ic("check",16)} KIRIM LAPORAN</button>
        </div>
        <div id="lp-sukses" class="hide center">
          <div class="big" style="width:64px;height:64px;margin:6px auto 14px;border-radius:999px;background:rgba(52,211,153,.15);border:1px solid rgba(52,211,153,.45);display:flex;align-items:center;justify-content:center;color:var(--emerald)">${ic("check",30,2.4)}</div>
          <h3>Laporan Terkirim!</h3>
          <div class="order-no" style="margin:14px 0"><span class="mono" id="lp-reportno"></span></div>
          <div id="lp-badge"></div>
          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:18px">
            <a class="btn btn-wa" id="lp-wa" target="_blank" rel="noopener">${ic("wa",16)} Kirim ke WA CS</a>
            <button class="btn btn-ghost" onclick="vLaporan(document.getElementById('view'))">Laporan Baru</button>
          </div>
        </div>
      </div>
      <div class="side">
        <div class="card">
          <b>Cek Status Laporan</b>
          <input type="text" id="lp-cek" class="mono" style="margin:10px 0" placeholder="LP-2026-0001">
          <button class="btn btn-ghost" id="lp-cekbtn" style="width:100%">${ic("search",15)} Cek Laporan</button>
          <div id="lp-cekres" style="margin-top:12px"></div>
        </div>
        <div class="card">
          <b>Hubungi CS Langsung</b>
          <p class="small muted" style="margin:6px 0 10px">${STORE.hours}</p>
          <a class="btn btn-wa btn-sm" style="width:100%" href="${waLink("Halo CS KIPLI STORE, saya ingin lapor kendala.")}" target="_blank" rel="noopener">${ic("wa",14)} WA CS ${STORE.waDisplay}</a>
        </div>
      </div>
    </div>
  </section>`;
  const photos = [];
  $("#lp-drop", el).addEventListener("click", ()=>$("#lp-file", el).click());
  $("#lp-file", el).addEventListener("change", async () => {
    for(const file of $("#lp-file", el).files){
      if(photos.length >= 3){ toast("Maksimal 3 foto"); break; }
      try{ photos.push(await compressImage(file)); }catch(e){}
    }
    renderLpPrev();
  });
  function renderLpPrev(){
    $("#lp-prev", el).innerHTML = photos.map((p,i)=>`<span style="position:relative"><img src="${p}" class="thumb" onclick="lbOpen(this.src)" alt="Foto bukti ${i+1}"><button class="btn btn-red btn-sm" style="position:absolute;top:-8px;right:-8px;padding:2px 6px;min-height:0" onclick="lpPhotos.splice(${i},1);lpRenderPrev()" aria-label="Hapus foto">${ic("trash",12)}</button></span>`).join("");
  }
  window.lpPhotos = photos; window.lpRenderPrev = renderLpPrev;
  $("#lp-submit", el).addEventListener("click", async () => {
    const nama = $("#lp-nama", el).value.trim(), desc = $("#lp-desc", el).value.trim(), no = $("#lp-no", el).value.trim();
    if(nama.length < 2) return toast("Isi nama kamu dulu");
    if(desc.length < 5) return toast("Ceritakan kendala kamu");
    const btn = $("#lp-submit", el); btn.disabled = true; btn.textContent = "Mengirim...";
    try{
      const j = await api("/api/reports", { method:"POST", headers:{ "Content-Type":"application/json" },
        body: JSON.stringify({ customerName: nama, orderNumber: no || undefined, description: desc, photos }) });
      if(j.ok && j.report){
        $("#lp-form", el).classList.add("hide");
        $("#lp-sukses", el).classList.remove("hide");
        $("#lp-reportno", el).textContent = j.report.reportNumber;
        $("#lp-badge", el).innerHTML = stBadge(j.report.status || "OPEN");
        $("#lp-wa", el).href = waLink(buildLaporanWa({ customerName: nama, orderNumber: j.report.reportNumber, description: desc }));
      } else { toast(j.error || "Gagal mengirim laporan"); btn.disabled = false; btn.innerHTML = ic("check",16)+" KIRIM LAPORAN"; }
    }catch(e){ toast("Tidak dapat terhubung ke server"); btn.disabled = false; btn.innerHTML = ic("check",16)+" KIRIM LAPORAN"; }
  });
  $("#lp-cekbtn", el).addEventListener("click", async () => {
    const no = $("#lp-cek", el).value.trim(); if(!no) return toast("Masukkan nomor laporan");
    const box = $("#lp-cekres", el); box.innerHTML = `<div class="skel" style="height:70px"></div>`;
    try{
      const j = await api("/api/reports?reportNumber=" + encodeURIComponent(no));
      box.innerHTML = j.ok ? `
        <div class="card" style="background:var(--bg2)">
          <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;align-items:center">
            <b class="mono">${esc(j.report.reportNumber)}</b>${stBadge(j.report.status)}
          </div>
          ${j.report.adminNote ? `<div class="notewarn" style="margin-top:8px">${ic("info",14)} ${esc(j.report.adminNote)}</div>` : ""}
          <p class="small muted" style="margin-top:8px">Dibuat ${timeAgo(j.report.createdAt)}</p>
        </div>` : `<div class="empty">${esc(j.error||"Laporan tidak ditemukan")}</div>`;
    }catch(e){ box.innerHTML = `<div class="empty">Tidak dapat terhubung ke server.</div>`; }
  });
}

/* ---------- TENTANG ---------- */
function vTentang(el){
  const fmtOrder = buildOrderWa({ customerName:"(nama kamu)", customerPhone:"(nomor wa)", itemsText:"- (nama item) - (jumlah)", paymentMethod:"QRIS / DANA / GoPay" });
  const fmtLaporan = buildLaporanWa({ customerName:"(nama kamu)", orderNumber:"(nomor pesanan)", description:"(detail kendala)" });
  el.innerHTML = `
  <section class="wrap" style="padding-top:30px">
    <span class="kicker">Tentang Kami</span>
    <h2 class="h2">KIPLI STORE — Pusat layanan terpercaya.</h2>
    <div class="grid g3" style="margin-top:20px">
      <div class="card"><div style="color:var(--green);margin-bottom:8px">${ic("wa",22)}</div><b>WhatsApp CS</b><p class="small muted" style="margin-top:4px">${STORE.waDisplay}</p><a class="btn btn-wa btn-sm" style="margin-top:10px" href="${waLink("Halo CS KIPLI STORE!")}" target="_blank" rel="noopener">Chat Sekarang</a></div>
      <div class="card"><div style="color:var(--sky);margin-bottom:8px">${ic("pin",22)}</div><b>Alamat</b><p class="small muted" style="margin-top:4px">${STORE.address}</p></div>
      <div class="card"><div style="color:var(--amber);margin-bottom:8px">${ic("clock",22)}</div><b>Jam Operasional</b><p class="small muted" style="margin-top:4px">${STORE.hours}</p></div>
    </div>

    <h2 class="h2" style="margin-top:34px">Pembayaran</h2>
    <div class="grid g3" style="margin-top:14px">
      <div class="card center">
        <b>QRIS</b>
        <img src="${STORE.qrisUrl}" alt="QRIS KIPLI STORE" style="border-radius:12px;margin:10px auto;cursor:pointer" onclick="lbOpen(this.src)">
        <p class="small muted">Semua e-wallet & mobile banking</p>
      </div>
      <div class="card"><b>DANA</b><p class="small muted" style="margin:6px 0">a.n. N*****I W****O</p>
        <div style="display:flex;align-items:center;gap:8px"><b class="mono" style="font-size:16px">089504379090</b><button class="btn btn-ghost btn-sm" onclick="copyText('089504379090')">${ic("copy",13)} Salin</button></div></div>
      <div class="card"><b>GoPay / OVO / ShopeePay</b><p class="small muted" style="margin:6px 0">a.n. N**G H***I</p>
        <div style="display:flex;align-items:center;gap:8px"><b class="mono" style="font-size:16px">089504379090</b><button class="btn btn-ghost btn-sm" onclick="copyText('089504379090')">${ic("copy",13)} Salin</button></div></div>
    </div>
    <div class="notewarn" style="margin-top:14px;justify-content:center;text-align:center;background:rgba(56,189,248,.08);border-color:rgba(56,189,248,.35);color:var(--sky);font-weight:800">${ic("info",15)} TANPA ADA PAJAK ATAU KODE UNIK — BAYAR PERSIS SESUAI TOTAL</div>

    <h2 class="h2" style="margin-top:34px">Format Pemesanan & Laporan</h2>
    <div class="grid g2" style="margin-top:14px">
      <div class="card"><b>Format Pesanan</b><pre class="format" style="margin-top:10px">${esc(fmtOrder)}</pre>
        <button class="btn btn-ghost btn-sm" style="margin-top:10px" onclick="copyText(document.querySelector('section pre.format').textContent)">${ic("copy",13)} Salin</button></div>
      <div class="card"><b>Format Laporan Kendala</b><pre class="format" style="margin-top:10px">${esc(fmtLaporan)}</pre>
        <button class="btn btn-ghost btn-sm" style="margin-top:10px" onclick="copyText($$('section pre.format')[1].textContent)">${ic("copy",13)} Salin</button></div>
    </div>

    <div class="center" style="margin-top:40px;padding-bottom:20px">
      <button class="btn btn-ghost" onclick="go('#/admin')" aria-label="Login admin">${ic("lock",14)} Login Admin</button>
    </div>
  </section>`;
}

/* ---------- ADMIN (login + kelola pesanan & laporan) ---------- */
let adminTimer;
function vAdmin(el){
  clearInterval(adminTimer);
  const pw = sessionStorage.getItem("kipli_admin");
  if(!pw){
    el.innerHTML = `
    <section class="wrap"><div class="login-box card">
      <div class="center" style="color:var(--sky);margin-bottom:10px">${ic("lock",30)}</div>
      <h2 class="h2 center" style="font-size:22px">Login Admin</h2>
      <p class="small muted center" style="margin-bottom:16px">Masukkan password admin untuk mengelola pesanan dari browser mana pun.</p>
      <label>PASSWORD ADMIN</label>
      <input type="password" id="ad-pw" placeholder="••••••••" autocomplete="current-password">
      <button class="btn btn-primary" id="ad-login" style="width:100%;margin-top:14px">Masuk</button>
      <p class="small muted center" style="margin-top:12px">Panel admin dapat dibuka dari browser & perangkat mana pun.</p>
    </div></section>`;
    $("#ad-login", el).addEventListener("click", adminLogin);
    $("#ad-pw", el).addEventListener("keydown", e => { if(e.key==="Enter") adminLogin(); });
    return;
  }
  el.innerHTML = `
  <section class="wrap" style="padding-top:30px">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
      <div><span class="kicker">Mode Admin</span><h2 class="h2" style="margin-bottom:0">Kelola Pesanan & Laporan</h2></div>
      <button class="btn btn-red btn-sm" onclick="sessionStorage.removeItem('kipli_admin');vAdmin(document.getElementById('view'))">Keluar</button>
    </div>
    <div class="tabs" style="margin-top:20px">
      <button class="on" id="tab-pesanan" onclick="adminTab('pesanan')">Pesanan</button>
      <button id="tab-laporan" onclick="adminTab('laporan')">Laporan</button>
    </div>
    <div id="admin-body"><div class="skel"></div><div class="skel"></div></div>
  </section>`;
  adminLoad("pesanan");
  adminTimer = setInterval(()=>{
    const abody = $("#admin-body"), ae = document.activeElement;
    if(abody && ae && (ae.tagName==="INPUT"||ae.tagName==="TEXTAREA") && abody.contains(ae)) return; /* jangan refresh saat admin sedang mengetik */
    const t = $(".tabs .on"); if(t) adminLoad(t.id==="tab-pesanan"?"pesanan":"laporan");
  }, 10000);
}
async function adminLogin(){
  const pw = $("#ad-pw").value;
  if(!pw) return toast("Masukkan password");
  const btn = $("#ad-login"); btn.disabled = true; btn.textContent = "Memeriksa...";
  try{
    const j = await api("/api/admin/login", { method:"POST", headers:{ "Content-Type":"application/json" }, body: JSON.stringify({ password: pw }) });
    if(j.ok){ sessionStorage.setItem("kipli_admin", pw); toast("Selamat datang, Admin!"); vAdmin($("#view")); }
    else { toast(j.error || "Password salah"); btn.disabled = false; btn.textContent = "Masuk"; }
  }catch(e){ toast("Tidak dapat terhubung ke server"); btn.disabled = false; btn.textContent = "Masuk"; }
}
function adminTab(t){
  $("#tab-pesanan").classList.toggle("on", t==="pesanan");
  $("#tab-laporan").classList.toggle("on", t==="laporan");
  adminLoad(t);
}
async function adminLoad(tab){
  const pw = sessionStorage.getItem("kipli_admin");
  const body = $("#admin-body"); if(!body){ clearInterval(adminTimer); return; }
  try{
    if(tab === "pesanan"){
      const j = await api("/api/admin/orders", { headers:{ "x-admin-password": pw } });
      if(!j.ok){ body.innerHTML = `<div class="empty">Sesi berakhir — login ulang.</div>`; clearInterval(adminTimer); return; }
      body.innerHTML = j.orders.length ? j.orders.map(o => adminOrderCard(o)).join("") : `<div class="empty">Belum ada pesanan masuk.</div>`;
    } else {
      const j = await api("/api/admin/reports", { headers:{ "x-admin-password": pw } });
      if(!j.ok){ body.innerHTML = `<div class="empty">Sesi berakhir — login ulang.</div>`; clearInterval(adminTimer); return; }
      body.innerHTML = j.reports.length ? j.reports.map(r => adminReportCard(r)).join("") : `<div class="empty">Belum ada laporan masuk.</div>`;
    }
  }catch(e){ body.innerHTML = `<div class="empty">Tidak dapat terhubung ke server.</div>`; }
}
function adminOrderCard(o){
  const digits = String(o.customerPhone||"").replace(/\D/g,"");
  const waCustomer = "https://wa.me/" + (digits.startsWith("62") ? digits : "62" + digits.replace(/^0/, ""));
  const actions = [];
  if(o.status === "PENDING"){ actions.push(`<button class="btn btn-primary btn-sm" onclick="adminSetStatus('${o.id}','ANTRIAN')">Konfirmasi & Masuk Antrian</button>`); actions.push(`<button class="btn btn-red btn-sm" onclick="adminSetStatus('${o.id}','DITOLAK')">Tolak</button>`); }
  if(o.status === "ANTRIAN"){ actions.push(`<button class="btn btn-primary btn-sm" onclick="adminSetStatus('${o.id}','DIPROSES')">Proses Sekarang</button>`); }
  if(o.status === "DIPROSES"){ actions.push(`<button class="btn btn-primary btn-sm" onclick="adminSetStatus('${o.id}','SELESAI')">Tandai Selesai</button>`); }
  const optLines = [];
  for(const it of o.items||[]){
    if(it.options) for(const [k,v] of Object.entries(it.options)){
      if(typeof v === "string" && v.startsWith("data:image")) optLines.push(`<span class="opt-line">${esc(k)}: <img src="${v}" class="thumb" style="vertical-align:middle" onclick="lbOpen(this.src)" alt="${esc(k)}"></span>`);
      else if(typeof v === "string" && v.includes("\n")) optLines.push(`<span class="opt-line">${esc(k)}:</span><pre class="format" style="max-height:160px">${esc(v)}</pre>`);
      else optLines.push(`<span class="opt-line">${esc(k)}: ${esc(String(v))}</span>`);
    }
  }
  return `
  <div class="admin-card">
    <div class="ahead">
      <b class="mono">${esc(o.orderNumber)}</b>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">${stBadge(o.status)}<span class="small muted">${timeAgo(o.createdAt)}</span></div>
    </div>
    <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;font-size:14px">
      <b>${esc(o.customerName)}</b>
      <a href="${waCustomer}" target="_blank" rel="noopener" class="small" style="display:inline-flex;align-items:center;gap:5px;color:var(--green)">${ic("wa",13)} ${esc(o.customerPhone)}</a>
    </div>
    <div class="items">
      ${o.items.map(it=>`<span><b>${esc(it.qty)}× ${esc(it.name)}</b> — ${fmt(it.price*it.qty)}</span>`).join("")}
      ${optLines.join("")}
      ${o.buktiUrl ? `<span class="opt-line">Bukti transfer:</span><img src="${o.buktiUrl}" class="thumb" onclick="lbOpen(this.src)" alt="Bukti transfer">` : `<span class="opt-line muted">Bukti transfer: belum diupload</span>`}
      ${o.note ? `<span class="opt-line" style="font-style:italic">Catatan: ${esc(o.note)}</span>` : ""}
    </div>
    <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:14px">
      <span class="muted">Total <b style="color:var(--sky)">${fmt(o.total)}</b> • ${esc(PAYMENT_LABELS[o.paymentMethod]||o.paymentMethod)}</span>
      ${o.queuePosition != null ? `<b style="color:var(--emerald)">Antrian #${o.queuePosition}</b>` : ""}
    </div>
    <div class="note-in">
      <input type="text" id="note-${o.id}" placeholder="Catatan untuk customer (tampil di cek status publik)" value="${esc(o.adminNote||"")}">
      <button class="btn btn-ghost btn-sm" onclick="adminSaveNote('${o.id}')">Simpan</button>
    </div>
    ${actions.length ? `<div class="actions">${actions.join("")}</div>` : ""}
  </div>`;
}
function adminReportCard(r){
  const actions = [];
  if(r.status === "OPEN") actions.push(`<button class="btn btn-primary btn-sm" onclick="adminReportStatus('${r.id}','DITINJAU')">Tandai Ditinjau</button>`);
  if(r.status === "DITINJAU") actions.push(`<button class="btn btn-primary btn-sm" onclick="adminReportStatus('${r.id}','SELESAI')">Tandai Selesai</button>`);
  return `
  <div class="admin-card">
    <div class="ahead">
      <b class="mono">${esc(r.reportNumber)}</b>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">${stBadge(r.status)}<span class="small muted">${timeAgo(r.createdAt)}</span></div>
    </div>
    <b>${esc(r.customerName)}</b> <span class="small muted">— pesanan: ${esc(r.orderNumber||"-")}</span>
    <p class="small" style="margin-top:6px">${esc(r.description)}</p>
    ${(r.photos&&r.photos.length) ? `<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">${r.photos.map(p=>`<img src="${p}" class="thumb" onclick="lbOpen(this.src)" alt="Foto laporan">`).join("")}</div>` : ""}
    <div class="note-in">
      <input type="text" id="rnote-${r.id}" placeholder="Catatan admin" value="${esc(r.adminNote||"")}">
      <button class="btn btn-ghost btn-sm" onclick="adminReportNote('${r.id}')">Simpan</button>
    </div>
    ${actions.length ? `<div class="actions">${actions.join("")}</div>` : ""}
  </div>`;
}
async function adminPatch(url, data, okMsg){
  const pw = sessionStorage.getItem("kipli_admin");
  try{
    const j = await api(url, { method:"PATCH", headers:{ "Content-Type":"application/json", "x-admin-password": pw }, body: JSON.stringify(data) });
    if(j.ok){ toast(okMsg); const t = $(".tabs .on"); adminLoad(t.id==="tab-pesanan"?"pesanan":"laporan"); }
    else toast(j.error || "Gagal");
  }catch(e){ toast("Tidak dapat terhubung ke server"); }
}
function adminSetStatus(id, status){ adminPatch("/api/admin/orders/"+id, { status }, "Status: " + (STATUS_LABEL[status]||status)); }
function adminSaveNote(id){ adminPatch("/api/admin/orders/"+id, { adminNote: $("#note-"+id).value }, "Catatan disimpan"); }
function adminReportStatus(id, status){ adminPatch("/api/admin/reports/"+id, { status }, "Laporan: " + (STATUS_LABEL[status]||status)); }
function adminReportNote(id){ adminPatch("/api/admin/reports/"+id, { adminNote: $("#rnote-"+id).value }, "Catatan disimpan"); }

/* ---------- BOOT ---------- */
$("#year").textContent = new Date().getFullYear();
/* Tanam logo base64 ke semua <img data-kipli-logo> + favicon → logo selalu muncul di mana saja */
document.querySelectorAll("img[data-kipli-logo]").forEach(im => { im.src = IMG_LOGO; });
const __fav = document.getElementById("favicon"); if(__fav) __fav.href = IMG_LOGO;
render();
pollTicker();
setInterval(pollTicker, 10000);
</script>
</body>
</html>
