    </div>
  </section>

  <div class="wrap"><div class="quick" id="quick"></div></div>

  <div class="wrap"><div class="promo" style="margin:10px 0 26px">
    <div>
      <span class="badge badge-free" style="margin-bottom:8px;display:inline-block">TERSEDIA</span>
      <h2 class="h2" style="margin-top:6px">JASAPOST — Promosikan Store Kamu</h2>
      <p class="sub">Post menjangkau semua grup & saluran. Format teks sudah disiapkan, tinggal isi spek & harga. Mulai GRATIS!</p>
    </div>
    <button class="btn btn-primary" onclick="go('#/layanan?cat=jasapost')">Coba Jasapost</button>
  </div></div>

  <section class="wrap">
    <span class="kicker">Produk Pilihan</span>
    <h2 class="h2">Produk paling dicari.</h2>
    <div class="grid g3" style="margin-top:18px">
      ${["apk-suntik","apk-nokos","nokos-indonesia"].map(id => { const f = findItem(id); const it = f.item; return `
      <div class="item" style="background:linear-gradient(160deg,rgba(37,99,235,.2),var(--card))">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div style="width:46px;height:46px;border-radius:13px;background:rgba(56,189,248,.16);color:var(--sky);display:flex;align-items:center;justify-content:center">${ic(catIcon(f.category.id),22)}</div>
          <span class="badge badge-free">AKTIF</span>
        </div>
        <h4 style="margin-top:6px">${esc(it.name)}</h4>
        <p class="desc">${esc(it.desc)}</p>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:8px">
          <b class="price">${fmt(it.price)}</b>
          <button class="btn btn-primary btn-sm" onclick="go('#/order?item=${it.id}')">Buka Produk</button>
        </div>
      </div>`; }).join("")}
    </div>
  </section>

  <section class="wrap" style="padding-bottom:56px">
    <span class="kicker">Cara Kerja</span>
    <h2 class="h2">Order cuma 4 langkah.</h2>
    <div class="steps" style="margin-top:18px">
      <div class="step"><span class="num">1</span><b>Pilih Layanan</b><p>Logo, Nokos, Jasapost, Jasasuntik, atau Produk Digital.</p></div>
      <div class="step"><span class="num">2</span><b>Isi Data & Opsi</b><p>Nama, nomor WA, opsi item, lampirkan foto bila diperlukan.</p></div>
      <div class="step"><span class="num">3</span><b>Pembayaran</b><p>QRIS / DANA / GoPay-OVO-ShopeePay, upload bukti transfer.</p></div>
      <div class="step"><span class="num">4</span><b>Masuk Antrian</b><p>Admin konfirmasi → pesanan masuk antrian yang bisa dilihat siapa pun.</p></div>
